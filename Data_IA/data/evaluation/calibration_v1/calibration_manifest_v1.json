  "variant_specs": {
    "clean_reference": {
      "target_dimension": "all",
      "construction_rule": "Contenido fiel a la respuesta esperada y chunks, coherente, relevante y adaptado a nivel principiante."
    },
    "low_relevance": {
      "target_dimension": "relevance",
      "construction_rule": "Contenido bien escrito pero parcialmente fuera del objetivo/pregunta del caso, sin inventar hechos."
    },
    "low_coherence": {
      "target_dimension": "coherence",
      "construction_rule": "Usar ideas correctas pero con secuencia o estructura deficiente, evitando introducir afirmaciones no respaldadas."
    },
    "poor_didactic_adaptation": {
      "target_dimension": "didactic_adaptation",
      "construction_rule": "Mantener hechos correctos, pero usar complejidad o jerga no apropiada para perfil principiante."
    },
    "unsupported_claim": {
      "target_dimension": "content_support",
      "construction_rule": "Agregar una afirmación factual plausible pero no respaldada por chunks_used."
    }
  },
