{
  "benchmark_name": "NuevaMente Retrieval Benchmark",
  "benchmark_run": "retrieval_v2_gt_v2",
  "benchmark_version": "2.0",
  "ground_truth_file": "Data_IA/data/evaluation/ground_truth_v2.csv",
  "corpus_file": "Data_IA/data/evaluation/chunks_v1.csv",
  "retrieval_input_file": "Data_IA/data/evaluation/input/retrieval_results_agentes_v2.json",
  "baseline_results_file": "Data_IA/data/evaluation/results/retrieval_results_gt_v2.csv",
  "total_cases_expected": 50,
  "ground_truth_frozen": true,
  "queries_frozen": true,
  "query_policy": {
    "source": "ground_truth_v2.pregunta",
    "use_original_query": true,
    "execution_method": "AgentV1.answer_for_evaluation",
    "fallback_allowed": false,
    "fallback_pattern": "Conceptos principales sobre"
  },
  "retrieval_v2": {
    "benchmark_filter_mode": "document_id",
    "benchmark_filter_source": "ground_truth_v2.document_id",
    "metadata_filters_enabled": true,
    "filter_trace_required": true,
    "supported_filter_modes": [
      "none",
      "document_id",
      "categoria",
      "document_id+categoria"
    ],
    "vector_search": true,
    "lexical_search_bm25": true,
    "rrf_enabled": true,
    "rrf_k": 60,
    "cross_encoder_reranking": true,
    "cross_encoder_model": "cross-encoder/ms-marco-MiniLM-L-6-v2",
    "overfetch_factor": 3,
    "embedding_model": "paraphrase-multilingual-mpnet-base-v2"
  },
  "metrics": [
    "recall_at_3",
    "recall_at_5",
    "precision_at_3",
    "precision_at_5"
  ],
  "analysis_requirements": {
    "global_metrics": true,
    "category_metrics": true,
    "critical_cases_analysis": true,
    "regression_analysis": true,
    "query_trace": true,
    "filter_impact_analysis": true
  },
  "critical_cases_expected": 11,
  "baseline_reference": {
    "recall_at_3": 0.573333,
    "recall_at_5": 0.753333,
    "precision_at_3": 0.213333,
    "precision_at_5": 0.164
  }
}
